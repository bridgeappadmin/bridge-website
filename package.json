{
  "name": "tazmify-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "check:phones": "node scripts/check-phone-mockups.mjs",
    "check:growth": "node scripts/check-growth-carousel.mjs",
    "check:hero": "node scripts/check-hero-splash.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node scripts/check-site.mjs",
    "check:animations": "node scripts/check-feature-animation.mjs && node scripts/check-deals-animation.mjs",
    "format": "prettier --write src scripts index.html package.json README.md",
    "postbuild": "node scripts/postbuild.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.1.0"
  }
}
